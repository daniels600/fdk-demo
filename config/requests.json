{
  "updateTicket": {
    "schema": {
      "method": "PUT",
      "host": "<%= iparam.domain %>.freshdesk.com",
      "path": "/api/v2/tickets/<%= context.ticket_id %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getTicketFields": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>.freshdesk.com",
      "path": "/api/v2/ticket_fields",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key + ':X') %>"
      }
    }
  },
  "queryNocoDB": {
    "schema": {
      "method": "GET",
      "host": "app.nocodb.com",
      "path": "/api/v2/tables/moeo293n3g8bj7k/records?where=(eurocode,eq,<%= context.eurocode %>)",
      "headers": {
        "xc-token": "<%= iparam.nocodb_token %>"
      }
    }
  },
  "queryNocoDBByOEM": {
    "schema": {
      "method": "GET",
      "host": "app.nocodb.com",
      "path": "/api/v2/tables/moeo293n3g8bj7k/records?where=(OEM1,eq,<%= context.oem %>)",
      "headers": {
        "xc-token": "<%= iparam.nocodb_token %>"
      }
    }
  }
}
