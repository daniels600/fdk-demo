{
  "domain": {
    "display_name": "Freshdesk Domain",
    "description": "Your Freshdesk subdomain (e.g., if your URL is https://ashesiedu.freshdesk.com, enter 'ashesiedu')",
    "type": "text",
    "required": true,
    "default_value": "ashesiedu"
  },
  "api_key": {
    "display_name": "Freshdesk API Key",
    "description": "Your Freshdesk API Key from Profile Settings",
    "type": "text",
    "required": true,
    "secure": true
  },
  "nocodb_token": {
    "display_name": "NocoDB API Token",
    "description": "API token from NocoDB settings",
    "type": "text",
    "required": true,
    "secure": true
  }
}
